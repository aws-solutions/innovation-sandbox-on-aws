{
  "name": "@amzn/innovation-sandbox-on-aws",
  "version": "1.3.2",
  "description": "Innovation Sandbox on AWS (SO0284)",
  "scripts": {
    "preinstall": "npm run generate-local-package-lock --workspaces --if-present",
    "test": "vitest run --coverage",
    "test:update-snapshots": "vitest run -u",
    "build": "npm run build --workspaces --if-present",
    "build:s3": "./deployment/build-s3-dist.sh",
    "build:open-source": "./deployment/build-open-source-dist.sh",
    "clean": "git clean -dfX -e \\!.env -e \\!.vscode \\!.idea",
    "env:init": "cp .env.example .env",
    "bootstrap": "./scripts/cdk/bootstrap.sh",
    "docker:build": ". .env && docker build --platform linux/amd64 -t $HUB_ACCOUNT_ID.dkr.ecr.$DEPLOY_REGION.amazonaws.com/$PRIVATE_ECR_REPO:latest ./source/infrastructure/lib/components/account-cleaner/image",
    "docker:login": ". .env && aws ecr get-login-password --region $DEPLOY_REGION | docker login --username AWS --password-stdin $HUB_ACCOUNT_ID.dkr.ecr.$DEPLOY_REGION.amazonaws.com",
    "docker:push": ". .env && docker push $HUB_ACCOUNT_ID.dkr.ecr.$DEPLOY_REGION.amazonaws.com/$PRIVATE_ECR_REPO:latest",
    "docker:build-and-push": "npm run docker:build && npm run docker:login && npm run docker:push",
    "deploy:all": "./scripts/cdk/deploy.sh",
    "deploy:account-pool": "./scripts/cdk/deploy.sh account-pool --skip-confirmation",
    "deploy:idc": "./scripts/cdk/deploy.sh idc --skip-confirmation",
    "deploy:data": "./scripts/cdk/deploy.sh data --skip-confirmation",
    "deploy:compute": "./scripts/cdk/deploy.sh compute --skip-confirmation",
    "destroy:all": "./scripts/cdk/destroy.sh",
    "destroy:account-pool": "./scripts/cdk/destroy.sh account-pool --skip-confirmation",
    "destroy:idc": "./scripts/cdk/destroy.sh idc --skip-confirmation",
    "destroy:data": "./scripts/cdk/destroy.sh data --skip-confirmation",
    "destroy:compute": "./scripts/cdk/destroy.sh compute --skip-confirmation"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "source/frontend",
    "source/layers/*",
    "source/lambdas/**",
    "source/infrastructure",
    "source/common"
  ],
  "devDependencies": {
    "zod": "^4.1.12",
    "zocker": "^3.0.0",
    "@aws-sdk/client-accessanalyzer": "^3.687.0",
    "@aws-sdk/client-cloudcontrol": "^3.692.0",
    "@aws-sdk/client-cloudformation": "^3.654.0",
    "@aws-sdk/client-cloudfront": "^3.687.0",
    "@aws-sdk/client-cloudwatch": "^3.687.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.687.0",
    "@aws-sdk/client-resource-explorer-2": "^3.654.0",
    "@aws-sdk/client-scheduler": "^3.758.0",
    "@aws-sdk/client-sfn": "^3.687.0",
    "@aws-sdk/credential-providers": "^3.693.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/fs-extra": "^11.0.4",
    "@types/http-errors": "^2.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "3.7.2",
    "@types/object-hash": "^3.0.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.10",
    "aws-sdk-client-mock": "^4.0.2",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "object-hash": "^3.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "supertest": "^7.0.0",
    "ts-retry": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "vitest": "^4.0.10",
    "vitest-mock-extended": "^2.0.2"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-organize-imports"
    ],
    "importOrder": [
      "^@amzn/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrderParserPlugins": [
      "typescript",
      "classProperties",
      "[\"decorators\", { \"decoratorsBeforeExport\": true }]"
    ]
  },
  "overrides": {
    "@aws-cdk/asset-awscli-v1": "^2.2.293",
    "@tanstack/react-query": "^5.74.4",
    "aws-cdk-lib": "^2.265.0",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "form-data": "^4.0.6",
    "js-cookie": "^3.0.7",
    "uuid": "^11.1.1"
  }
}
