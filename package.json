{
  "name": "@amzn/innovation-sandbox-on-aws",
  "version": "1.4.0",
  "description": "Innovation Sandbox on AWS (SO0284)",
  "scripts": {
    "preinstall": "npm run generate-local-package-lock --workspaces --if-present",
    "pretest": "npm run smithy:prepare",
    "test": "vitest run --coverage",
    "smithy:verify:compatibility": "npm run verify:compatibility --workspace @amzn/innovation-sandbox-api-model --",
    "test:update-snapshots": "vitest run -u",
    "test:mcp": "python3 -B -m unittest discover -s scripts/mcp",
    "verify:layer-lockfiles": "(npm --prefix source/layers/common ci --workspaces=false --install-links --dry-run --ignore-scripts --no-audit --no-fund && npm --prefix source/layers/dependencies ci --workspaces=false --install-links --dry-run --ignore-scripts --no-audit --no-fund) || (printf \"\\nLayer lockfile verification failed. Run npm install again from the repository root.\\n\" >&2; exit 1)",
    "prebuild": "npm run verify:layer-lockfiles",
    "build": "npm run smithy:prepare && npm run build --workspaces --if-present",
    "build:s3": "./deployment/build-s3-dist.sh",
    "build:open-source": "./deployment/build-open-source-dist.sh",
    "clean": "git clean -dfX -e \\!*.env -e \\!.vscode \\!.idea",
    "env:init": "bash ./scripts/env/init.sh",
    "env:use": "bash ./scripts/env/use.sh",
    "env:current": "bash ./scripts/env/current.sh",
    "bootstrap": "./scripts/cdk/bootstrap.sh",
    "docker:build": "./scripts/docker/build.sh",
    "docker:login": "./scripts/docker/login.sh",
    "docker:push": "./scripts/docker/push.sh",
    "docker:build-and-push": "./scripts/docker/build-and-push.sh",
    "agent-runtime:source-tag": "tsx --tsconfig source/infrastructure/tsconfig.json source/infrastructure/bin/agent-runtime-source-tag.ts",
    "deploy:all": "./scripts/cdk/deploy.sh",
    "deploy:account-pool": "./scripts/cdk/deploy.sh account-pool --skip-confirmation",
    "deploy:idc": "./scripts/cdk/deploy.sh idc --skip-confirmation",
    "deploy:data": "./scripts/cdk/deploy.sh data --skip-confirmation",
    "deploy:compute": "./scripts/cdk/deploy.sh compute --skip-confirmation",
    "destroy:all": "./scripts/cdk/destroy.sh",
    "destroy:account-pool": "./scripts/cdk/destroy.sh account-pool --skip-confirmation",
    "destroy:idc": "./scripts/cdk/destroy.sh idc --skip-confirmation",
    "destroy:data": "./scripts/cdk/destroy.sh data --skip-confirmation",
    "destroy:compute": "./scripts/cdk/destroy.sh compute --skip-confirmation",
    "smithy:generate": "npm run generate --workspace @amzn/innovation-sandbox-api-model --",
    "smithy:prepare": "npm run smithy:generate && npm run build --workspace @amzn/innovation-sandbox-api-client --workspace @amzn/innovation-sandbox-api-server"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "source/frontend",
    "source/layers/*",
    "source/lambdas/**",
    "source/infrastructure",
    "source/common",
    "source/shared",
    "source/api-model",
    "source/api-client",
    "source/api-server",
    "source/agent-runtime"
  ],
  "devDependencies": {
    "@aws-sdk/client-scheduler": "^3.1101.0",
    "@smithy/server-apigateway": "0.3.3",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/fs-extra": "^11.0.4",
    "@types/http-errors": "^2.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "3.7.2",
    "@types/object-hash": "^3.0.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.10",
    "@smithy/core": "3.33.3",
    "@smithy/types": "4.17.2",
    "aws-sdk-client-mock": "^4.0.2",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "object-hash": "^3.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "supertest": "^7.0.0",
    "ts-retry": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "vitest": "^4.0.10",
    "vitest-mock-extended": "^2.0.2",
    "zocker": "^3.0.0",
    "zod": "^4.1.12"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-organize-imports"
    ],
    "importOrder": [
      "^@amzn/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrderParserPlugins": [
      "typescript",
      "classProperties",
      "[\"decorators\", { \"decoratorsBeforeExport\": true }]"
    ]
  },
  "overrides": {
    "@aws-cdk/asset-awscli-v1": "^2.2.293",
    "@tanstack/react-query": "^5.74.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "uuid": "^11.1.1",
    "@smithy/core": "3.33.3",
    "@smithy/types": "4.17.2",
    "@opentelemetry/sdk-node": {
      "@opentelemetry/propagator-jaeger": "^2.9.0"
    },
    "@opentelemetry/instrumentation-cassandra-driver": "0.66.0",
    "@opentelemetry/instrumentation-knex": "0.65.0",
    "@opentelemetry/instrumentation-mongoose": "0.67.0",
    "@opentelemetry/instrumentation-mysql": "0.67.0",
    "@opentelemetry/instrumentation-mysql2": "0.67.0",
    "@opentelemetry/instrumentation-oracledb": "0.46.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/instrumentation-tedious": "0.40.0"
  }
}
