{
  "name": "@amzn/innovation-sandbox-agent-runtime",
  "description": "AgentCore Runtime - Innovation Sandbox on AWS (SO0284)",
  "version": "1.4.0",
  "scripts": {
    "build": "tsc --incremental --noEmit",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@amzn/innovation-sandbox-agent-runtime=./src --alias:@amzn/innovation-sandbox-commons=../common --alias:@amzn/innovation-sandbox-shared=../shared --banner:js=\"import{createRequire as __isbCreateRequire}from'node:module';const require=__isbCreateRequire(import.meta.url);\" --outfile=dist/main.mjs",
    "test": "vitest run"
  },
  "type": "module",
  "license": "Apache-2.0",
  "dependencies": {
    "@amzn/innovation-sandbox-layer-dependencies": "file:../layers/dependencies",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1137.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1137.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "^0.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@smithy/protocol-http": "^5.3.0",
    "@smithy/signature-v4": "^5.6.12",
    "@smithy/types": "^4.6.0",
    "@strands-agents/sdk": "1.22.0",
    "aws-xray-sdk-core": "^3.12.0",
    "bedrock-agentcore": "^0.4.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
