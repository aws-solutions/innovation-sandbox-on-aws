        "openapi": {
          "service": "com.amazon.isb#IsbApi",
          "protocol": "aws.protocols#restJson1",
          "apiGatewayDefaults": "2023-08-11",
          "tags": true,
          "jsonAdd": {
            "/tags": [
              {
                "name": "leases",
                "description": "Contract that provides a user with temporary access to a sandbox account"
              },
              {
                "name": "leaseTemplates",
                "description": "Configurations that can be used to request a sandbox lease"
              },
              {
                "name": "blueprints",
                "description": "Pre-configured infrastructure templates that deploy CloudFormation StackSets to sandbox accounts"
              },
              {
                "name": "accounts",
                "description": "AWS accounts registered as sandbox accounts within the solution"
              },
              {
                "name": "configurations",
                "description": "Global configurations used by the solution"
              },
              {
                "name": "principals",
                "description": "IAM Identity Center principal discovery for lease assignment"
              }
            ],
            "/servers": [
              {
                "url": "{apiBaseUrl}",
                "description": "Base URL used to make API requests",
                "variables": {
                  "apiBaseUrl": {
                    "default": "https://example.com/api",
                    "description": "Base URL used to make API requests"
                  }
                }
              }
            ],
            "/info/license": {
              "name": "Apache 2.0",
              "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
            },
            "/components/securitySchemes/aws.auth.sigv4/description": "AWS Signature Version 4 over the `execute-api` service. Required on every request: the API uses IAM authorization (`AuthorizationType.IAM`), and there is no bearer-token or Cognito authorizer. The caller type is determined from the IAM principal.",
            "/components/securitySchemes/isbIdentity": {
              "type": "apiKey",
              "name": "x-isb-identity",
              "in": "header",
              "description": "Cognito ID token, verified via JWKS. Carries the claims used for RBAC. Required for human callers (Identity Pool roles). M2M callers (per-client assumed IAM roles) derive their role from the assumed-role ARN and must NOT send this header; a request presenting both an M2M principal and `x-isb-identity` is rejected with 400."
            },
            "/security": [
              {
                "aws.auth.sigv4": [],
                "isbIdentity": []
              },
              {
                "aws.auth.sigv4": []
              }
            ],
