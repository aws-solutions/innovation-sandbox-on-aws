{
  "name": "@amzn/innovation-sandbox-api-server",
  "description": "Innovation Sandbox on AWS server bindings (one subpath per domain)",
  "version": "1.3.5",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json"
  },
  "exports": {
    "./lease-templates": {
      "types": "./dist-types/lease-templates/index.d.ts",
      "default": "./dist-cjs/lease-templates/index.js"
    },
    "./configurations": {
      "types": "./dist-types/configurations/index.d.ts",
      "default": "./dist-cjs/configurations/index.js"
    },
    "./principals": {
      "types": "./dist-types/principals/index.d.ts",
      "default": "./dist-cjs/principals/index.js"
    },
    "./accounts": {
      "types": "./dist-types/accounts/index.d.ts",
      "default": "./dist-cjs/accounts/index.js"
    },
    "./leases": {
      "types": "./dist-types/leases/index.d.ts",
      "default": "./dist-cjs/leases/index.js"
    },
    "./blueprints": {
      "types": "./dist-types/blueprints/index.d.ts",
      "default": "./dist-cjs/blueprints/index.js"
    }
  },
  "dependencies": {
    "tslib": "^2.6.2",
    "@aws-sdk/core": "^3.975.2",
    "@aws-smithy/server-common": "npm:@smithy/server-common@0.1.6",
    "@smithy/core": "^3.29.3",
    "@smithy/fetch-http-handler": "^5.6.5",
    "@smithy/node-http-handler": "^4.9.5",
    "@smithy/types": "^4.16.1"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.8",
    "typescript": "~5.8.3",
    "@types/node": "^20.14.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist-*/**"
  ]
}
