    "IsbOpenApiRestApi": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Body": {
          "openapi": "3.0.2",
          "info": {
            "title": "Innovation Sandbox on AWS",
            "version": "2026-08-25",
            "description": "Innovation Sandbox on AWS enables cloud administrators to automate the\\nmanagement of temporary sandbox environments by implementing service\\ncontrol policies, spend controls, and account recycling mechanisms.\\n\\nThe API is organized into these domains:\\n\\n- **Accounts**: Register and manage sandbox accounts, cleanup runs, and\\n  account lifecycle actions.\\n- **Blueprints**: Register and manage CloudFormation StackSet-backed\\n  blueprints.\\n- **Configurations**: Read and update solution settings for leases, cleanup,\\n  notifications, maintenance, terms of service, and cost reporting.\\n- **Leases**: Request and manage temporary sandbox access, lifecycle actions,\\n  sharing, and principal assignments.\\n- **Lease templates**: Define the reusable budget, duration, blueprint, and\\n  visibility settings used to request leases.\\n- **Principals**: Search IAM Identity Center users and groups for lease\\n  assignments.",
            "license": {
              "name": "Apache 2.0",
              "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
            }
          },
          "paths": {
            "/accounts": {
              "get": {
                "description": "Paginated list of registered sandbox accounts. \`maxResults\` caps at 2000.",
                "operationId": "ListAccounts",
                "parameters": [
                  {
                    "name": "pageIdentifier",
                    "in": "query",
                    "description": "Opaque pagination token.",
                    "schema": {
                      "type": "string",
                      "description": "Opaque pagination token.",
                      "format": "password"
                    }
                  },
                  {
                    "name": "maxResults",
                    "in": "query",
                    "schema": {
                      "type": "number",
                      "maximum": 2000,
                      "minimum": 1
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "ListAccounts 200 response",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ListAccountsResponseContent"
                        }
                      }
                    }
                  },
                  "400": {
