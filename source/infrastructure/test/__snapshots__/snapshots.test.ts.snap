        "ScheduleExpression": "rate(1 hour)",
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "PrincipalCacheSyncSyncLambdaFunctionA81205AF",
              "Arn"
            ]
          },
          "Input": "{\\"source\\":\\"scheduled\\"}",
          "RetryPolicy": {
            "MaximumRetryAttempts": 2
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "PrincipalCacheSyncSchedulerInvokeRole2FF40F32",
              "Arn"
            ]
          }
        }
