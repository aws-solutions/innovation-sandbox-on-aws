        "LoggingConfig": {
          "ApplicationLogLevel": "INFO",
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "ISBLogGroupE607F9A7"
          },
          "SystemLogLevel": "INFO"
        },
        "MemorySize": 1024,
        "ReservedConcurrentExecutions": 1,
        "Role": {
          "Fn::GetAtt": [
            "GroupCostReportingLambdaFunctionRole775BD77E",
            "Arn"
          ]
        },
        "Runtime": "nodejs24.x",
        "Tags": [
