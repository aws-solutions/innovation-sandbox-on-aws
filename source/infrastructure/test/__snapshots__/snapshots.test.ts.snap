            "/principals/search": {
              "get": {
                "description": "Searches IDC principals for the assignment UI.\\n\\nTwo modes on one route, selected by \`exact\`:\\n  - fuzzy (\`exact=false\`, the default): case-insensitive substring match over\\n    the cached principals, capped at \`limit\`; requires\\n    \`leases.enablePrincipalSearch\` (else 403 \`AccessDeniedError\`);\\n  - exact (\`exact=true\`): resolves one principal by exact attribute through IDC;\\n    requires a non-empty \`q\` and a specific \`type\`\\n    (\`users\` or \`groups\`, not \`all\`) — otherwise 400 — and returns 404 when no\\n    principal resolves. Exact lookups bypass \`leases.enablePrincipalSearch\`,\\n    but group lookups still require \`leases.groupAssignmentMode\` to be \`ALL\`.\\n\\nWhen \`leases.groupAssignmentMode\` is \`NONE\`, explicit fuzzy or exact group\\nsearches return 403, and unfiltered fuzzy searches return users only. Existing\\ngroup associations remain visible through lease assignment reads.\\n\\nApplies these defaults when a parameter is absent: \`q=\\"\\"\`, \`type=all\`,\\n\`limit=20\`, \`exact=false\`.\\n\\nThis operation is not paginated: it is a typeahead search, not a\\nlist/describe. The caller shows the top \`limit\` matches (≤ 100) and never\\npages; \`totalMatches\` exists only so the UI can show \\"N of M\\".",
                "operationId": "SearchPrincipals",
                "parameters": [
                  {
                    "name": "q",
                    "in": "query",
                    "description": "Case-insensitive substring matched against display name and email.",
                    "schema": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Case-insensitive substring matched against display name and email."
                    },
                    "examples": {
                      "SearchPrincipals_example1": {
                        "summary": "Search principals by name",
                        "description": "",
                        "value": "jane"
                      }
                    }
                  },
                  {
                    "name": "type",
                    "in": "query",
                    "description": "The \`type\` query filter: restrict to users, groups, or both. The public wire\\nvalues are lowercase.",
                    "schema": {
                      "$ref": "#/components/schemas/PrincipalSearchTypeFilter"
                    }
                  },
                  {
                    "name": "limit",
                    "in": "query",
                    "description": "Maximum matches to return. The operation defaults it to 20 when absent.",
                    "schema": {
                      "type": "number",
                      "maximum": 100,
                      "minimum": 1,
                      "description": "Maximum matches to return. The operation defaults it to 20 when absent."
                    }
                  },
                  {
                    "name": "exact",
                    "in": "query",
                    "description": "When true, resolve one principal by exact attribute instead of fuzzy\\nsearch.",
                    "schema": {
                      "type": "boolean",
                      "description": "When true, resolve one principal by exact attribute instead of fuzzy\\nsearch."
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "SearchPrincipals 200 response",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/SearchPrincipalsResponseContent"
                        },
                        "examples": {
                          "SearchPrincipals_example1": {
                            "summary": "Search principals by name",
                            "description": "",
                            "value": {
                              "status": "success",
                              "data": {
                                "principals": [
                                  {
                                    "principalId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                                    "principalType": "USER",
                                    "displayName": "Jane Doe",
                                    "email": "jane@example.com"
                                  }
                                ],
                                "totalMatches": 47
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "ValidationError 400 response",
                    "content": {
