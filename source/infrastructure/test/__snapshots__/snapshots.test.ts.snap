                  }
                },
                "required": [
                  "status"
                ]
              },
              "AccountMetadata": {
                "type": "object",
                "description": "Record metadata. Only the timestamps are public.",
                "properties": {
                  "createdTime": {
                    "type": "string",
                    "example": "2023-05-01T12:00:00Z"
                  },
                  "lastEditTime": {
                    "type": "string",
                    "example": "2023-05-01T12:00:00Z"
                  }
                }
              },
              "ActiveCleanup": {
                "type": "object",
                "description": "In-flight cleanup summary attached to an account while it is being cleaned.",
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "The cleanup phase. Open string: enumerated phases plus \`NUKE_PHASE_<n>\`."
                  },
                  "executionArn": {
                    "type": "string"
                  },
                  "startedAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "executionArn",
                  "startedAt",
                  "status"
                ]
              },
              "AdminConfiguration": {
                "type": "object",
                "description": "The full configuration the settings UI loads: every section (each with its\\naudit fields) plus the deploy-time fields resolved outside the config store.",
                "properties": {
                  "leases": {
                    "$ref": "#/components/schemas/LeasesConfiguration"
                  },
                  "cleanup": {
                    "$ref": "#/components/schemas/CleanupConfiguration"
                  },
                  "notification": {
                    "$ref": "#/components/schemas/NotificationConfiguration"
                  },
                  "maintenance": {
                    "$ref": "#/components/schemas/MaintenanceConfiguration"
                  },
                  "termsOfService": {
                    "$ref": "#/components/schemas/TermsOfServiceConfiguration"
                  },
                  "costReporting": {
                    "$ref": "#/components/schemas/CostReportingConfiguration"
                  },
                  "isbManagedRegions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "description": "Regions the account pool is configured to manage.",
                    "example": [
                      "us-east-1",
                      "us-west-2"
                    ]
                  },
                  "awsAccessPortalUrl": {
                    "type": "string"
                  }
                },
                "required": [
                  "awsAccessPortalUrl",
                  "cleanup",
                  "costReporting",
                  "isbManagedRegions",
                  "leases",
                  "maintenance",
                  "notification",
                  "termsOfService"
                ]
              },
              "AssignmentSyncStatus": {
                "type": "string",
                "description": "Per-principal reconciliation status of a lease assignment. Each in-flight\\nstate pairs with the failure it becomes if it never settles\\n(\`granting\` → \`grantFailed\`, \`revoking\` → \`revokeFailed\`):\\n- \`active\` — desired and assigned.\\n- \`granting\` — desired, not yet assigned; an operation is in flight.\\n- \`revoking\` — assigned but on its way out.\\n- \`suspended\` — intentionally not assigned because the lease grants nobody\\n  access (frozen or terminal, or a freeze/terminate in flight); expected,\\n  not a failure.\\n- \`grantFailed\` — desired and settled, but no assignment exists.\\n- \`revokeFailed\` — settled, but an assignment exists that should not: either\\n  the principal is no longer desired, or the lease grants no access.",
                "enum": [
                  "active",
                  "granting",
                  "revoking",
                  "suspended",
                  "grantFailed",
                  "revokeFailed"
                ]
              },
              "AssignmentView": {
                "type": "object",
                "description": "One row of the assignments view: the union of a lease's desired set and its\\nlive assignments, annotated with reconciliation state. Rows sourced only from\\nthe desired set have no assignment yet, so \`assigneeEmail\`/\`addedBy\`/\`addedDate\`\\nare absent.",
                "properties": {
                  "principalId": {
                    "type": "string",
                    "description": "IDC user id (for \`USER\` assignments) or group id (for \`GROUP\` assignments).",
                    "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                  },
                  "principalType": {
                    "$ref": "#/components/schemas/PrincipalType"
                  },
                  "displayName": {
                    "type": "string",
                    "description": "Display name of the user or group."
                  },
                  "assigneeEmail": {
                    "type": "string",
                    "description": "Email of the assigned user (USER assignments only).",
                    "format": "password"
                  },
                  "addedBy": {
                    "type": "string",
                    "description": "Email of the user who created this assignment. Absent for a principal that is\\ndesired but not yet granted.",
                    "format": "password"
                  },
                  "addedDate": {
                    "type": "string"
                  },
                  "isOwner": {
                    "type": "boolean",
                    "description": "True for the lease owner, whose access is implicit and not removable."
                  },
                  "isDesired": {
                    "type": "boolean",
                    "description": "Whether the principal is in the lease's desired set. This cannot be inferred\\nfrom \`syncStatus\`."
                  },
                  "syncStatus": {
                    "$ref": "#/components/schemas/AssignmentSyncStatus"
                  }
                },
                "required": [
                  "displayName",
                  "isDesired",
                  "isOwner",
                  "principalId",
                  "principalType",
                  "syncStatus"
                ]
              },
              "Blueprint": {
                "type": "object",
                "description": "A registered blueprint.",
                "properties": {
                  "blueprintId": {
                    "type": "string",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "A blueprint id — the server-generated UUID. The pattern is the exact RFC layout\\n(versions 1–8, variant 8/9/a/b, plus the nil and max UUIDs), so a hex-shaped but\\nRFC-invalid id is rejected 400 rather than returning 404.",
                    "example": "12345678-90ab-4cde-8f12-34567890abcd"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,49}$",
                    "example": "Web-Application-Blueprint"
                  },
                  "tags": {
                    "$ref": "#/components/schemas/BlueprintTags"
                  },
                  "createdBy": {
                    "type": "string",
                    "description": "An email address.",
                    "format": "password"
                  },
                  "deploymentTimeoutMinutes": {
                    "type": "number",
                    "maximum": 480,
                    "minimum": 5,
                    "format": "double",
                    "example": 60
                  },
                  "regionConcurrencyType": {
                    "$ref": "#/components/schemas/RegionConcurrencyType"
                  },
                  "totalHealthMetrics": {
                    "$ref": "#/components/schemas/BlueprintHealthMetrics"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/BlueprintMetadata"
                  }
                },
                "required": [
                  "blueprintId",
                  "createdBy",
                  "deploymentTimeoutMinutes",
                  "name",
                  "regionConcurrencyType",
                  "totalHealthMetrics"
                ]
              },
              "BlueprintHealthMetrics": {
                "type": "object",
                "description": "Aggregated blueprint health metrics (computed from all StackSets).",
                "properties": {
                  "totalDeploymentCount": {
                    "type": "number",
                    "format": "double"
                  },
                  "totalSuccessfulCount": {
                    "type": "number",
                    "format": "double"
                  },
                  "lastDeploymentAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "totalDeploymentCount",
                  "totalSuccessfulCount"
                ]
              },
              "BlueprintMetadata": {
                "type": "object",
                "description": "Record metadata. Timestamps are ISO 8601 strings.",
                "properties": {
                  "schemaVersion": {
                    "type": "number",
                    "example": 1
                  },
                  "createdTime": {
                    "type": "string",
                    "example": "2023-05-01T12:00:00Z"
                  },
                  "lastEditTime": {
                    "type": "string",
                    "example": "2023-05-01T12:00:00Z"
                  }
                },
                "required": [
                  "createdTime",
                  "lastEditTime",
                  "schemaVersion"
                ]
              },
              "BlueprintTags": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^[a-zA-Z0-9_:./@ +=$%&*()\\\\[\\\\]{}|\\\\\\\\!#^~?-]*$",
                  "description": "Tag value: up to 256 chars from the same set (empty allowed)."
                },
                "maxProperties": 10,
                "description": "Up to 10 key-value tags.",
                "example": {
                  "environment": "production",
                  "team": "platform"
                }
              },
              "BlueprintWithStackSets": {
                "type": "object",
                "description": "The composite a read path returns: the blueprint, its StackSets, and the most\\nrecent deployments.",
                "properties": {
                  "blueprint": {
                    "$ref": "#/components/schemas/Blueprint"
                  },
                  "stackSets": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/StackSetConfig"
                    }
                  },
                  "recentDeployments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DeploymentHistory"
                    }
                  }
                },
                "required": [
                  "blueprint",
                  "stackSets"
                ]
              },
              "BudgetThreshold": {
                "type": "object",
                "properties": {
                  "dollarsSpent": {
                    "type": "number",
                    "format": "double",
                    "example": 80
                  },
                  "action": {
                    "$ref": "#/components/schemas/ThresholdAction"
                  }
                },
                "required": [
                  "action",
                  "dollarsSpent"
                ]
              },
              "CleanupConfiguration": {
                "type": "object",
                "description": "Account cleanup retry/validation policy.",
                "properties": {
                  "numberOfFailedAttemptsToCancelCleanup": {
                    "type": "number",
                    "minimum": 1
                  },
                  "waitBeforeRetryFailedAttemptSeconds": {
                    "type": "number",
                    "minimum": 1
                  },
                  "numberOfSuccessfulAttemptsToFinishCleanup": {
                    "type": "number",
                    "minimum": 1
                  },
                  "waitBeforeRerunSuccessfulAttemptSeconds": {
                    "type": "number",
                    "minimum": 1
                  },
                  "validation": {
                    "$ref": "#/components/schemas/CleanupValidation"
                  },
                  "cooldownPeriodHours": {
                    "type": "number",
                    "maximum": 8640,
                    "minimum": 0,
                    "description": "Hours to hold an account in the CleanUp OU after a successful cleanup before\\nreturning it to Available (\`0\` = disabled; max 8640 = 360 days)."
                  },
                  "reportRetentionDays": {
                    "type": "number",
                    "maximum": 3650,
                    "minimum": 14,
                    "description": "Days to retain cleanup reports."
                  },
                  "lastSavedBy": {
                    "type": "string",
                    "description": "Email of the last administrator to save the section, or a \`system:\` sentinel.",
                    "format": "password"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/ConfigurationResponseMetadata"
                  }
                },
                "required": [
                  "cooldownPeriodHours",
                  "numberOfFailedAttemptsToCancelCleanup",
                  "numberOfSuccessfulAttemptsToFinishCleanup",
                  "reportRetentionDays",
                  "validation",
                  "waitBeforeRerunSuccessfulAttemptSeconds",
                  "waitBeforeRetryFailedAttemptSeconds"
                ]
              },
              "CleanupExecutionContext": {
                "type": "object",
                "description": "Deprecated legacy Step Function context, still emitted when present.",
                "properties": {
                  "stateMachineExecutionArn": {
                    "type": "string"
                  },
                  "stateMachineExecutionStartTime": {
                    "type": "string"
                  }
                },
                "required": [
                  "stateMachineExecutionArn",
                  "stateMachineExecutionStartTime"
                ]
              },
              "CleanupFailureAction": {
                "type": "string",
                "enum": [
                  "Quarantine",
                  "Warn",
                  "Silent"
                ]
              },
              "CleanupReport": {
                "type": "object",
                "description": "A cleanup report.",
                "properties": {
                  "accountId": {
                    "type": "string",
                    "pattern": "^[0-9]{12}$",
                    "description": "A 12-digit AWS account id.",
                    "example": "123456789012"
                  },
                  "durableExecutionArn": {
                    "type": "string",
                    "example": "arn:aws:lambda:us-east-1:123456789012:function:ISB-DurableOrchestration:1/durable-execution/abc123"
                  },
                  "status": {
                    "$ref": "#/components/schemas/CleanupReportStatus"
                  },
                  "cleanupStatus": {
                    "type": "string",
                    "description": "Open string: enumerated cleanup phases plus \`NUKE_PHASE_<n>\`.",
                    "example": "NUKE_PHASE_1"
                  },
                  "startedAt": {
                    "type": "string",
                    "example": "2026-03-25T14:30:00.000Z"
                  },
                  "completedAt": {
                    "type": "string",
                    "example": "2026-03-25T15:45:00.000Z"
                  },
                  "reasonForCleanup": {
                    "type": "string",
                    "description": "Backward-compatible cleanup reason (enumerated plus legacy values).",
                    "example": "LEASE_TERMINATION"
                  },
                  "initiatedBy": {
                    "type": "string"
                  },
                  "resourceSummary": {
                    "$ref": "#/components/schemas/ResourceSummary"
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CleanupStep"
                    }
                  },
                  "error": {
                    "$ref": "#/components/schemas/CleanupReportError"
                  },
                  "cooldownSkippedBy": {
                    "type": "string"
                  }
                },
                "required": [
                  "accountId",
                  "cleanupStatus",
                  "durableExecutionArn",
                  "reasonForCleanup",
                  "startedAt",
                  "status",
                  "steps"
                ]
              },
              "CleanupReportError": {
                "type": "object",
                "description": "A cleanup failure: the failing step and its message.",
                "properties": {
                  "step": {
                    "type": "string",
                    "example": "validate-spoke-role"
                  },
                  "message": {
                    "type": "string",
                    "example": "Cleanup spoke role not found"
                  }
                },
                "required": [
                  "message",
                  "step"
                ]
              },
              "CleanupReportStatus": {
                "type": "string",
                "description": "Overall lifecycle status of a cleanup run.",
                "enum": [
                  "IN_PROGRESS",
                  "COMPLETED",
                  "FAILED"
                ],
                "example": "COMPLETED"
              },
              "CleanupStep": {
                "type": "object",
                "description": "One appended cleanup step. \`meta\` carries step-specific data as an opaque map.",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "nuke-phase-1"
                  },
                  "startedAt": {
                    "type": "string",
                    "example": "2026-03-25T14:30:00.000Z"
                  },
                  "completedAt": {
                    "type": "string"
                  },
                  "meta": {}
                },
                "required": [
                  "name",
                  "startedAt"
                ]
              },
              "CleanupValidation": {
                "type": "object",
                "properties": {
                  "failureAction": {
                    "$ref": "#/components/schemas/CleanupFailureAction"
                  }
                },
                "required": [
                  "failureAction"
                ]
              },
              "ConcurrencyMode": {
                "type": "string",
                "description": "CloudFormation StackSet concurrency mode — how concurrency reacts to failures.",
                "enum": [
                  "STRICT_FAILURE_TOLERANCE",
                  "SOFT_FAILURE_TOLERANCE"
                ]
              },
              "ConfigurationResponseMetadata": {
                "type": "object",
                "description": "Response metadata. Both timestamps are \`@required\`: a saved section always\\ncarries both, and a partial \`meta\` must never be sent back — a \`meta\` missing\\n\`lastEditTime\` would drop the concurrency token and silently downgrade the next\\nwrite to a first-save.",
                "properties": {
                  "createdTime": {
                    "type": "string",
                    "example": "2023-05-01T12:00:00Z"
                  },
                  "lastEditTime": {
                    "type": "string",
                    "description": "The optimistic-concurrency token: a write must echo the value it last read,\\nor the store rejects it with a 409. Opaque — echoed back unchanged.",
                    "example": "2023-05-01T12:00:00Z"
                  }
                },
                "required": [
                  "createdTime",
                  "lastEditTime"
                ]
              },
              "ConfigurationWriteMetadata": {
                "type": "object",
                "description": "Write-side metadata: only the optimistic-concurrency token. \`createdTime\` is\\nserver-owned and excluded; a first save omits \`lastEditTime\` entirely.",
                "properties": {
                  "lastEditTime": {
                    "type": "string"
                  }
                }
              },
              "ConflictErrorResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "message": {
                    "type": "string"
                  },
                  "data": {
                    "$ref": "#/components/schemas/JSendErrorData"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "CostReportingConfiguration": {
                "type": "object",
                "description": "Cost-report grouping policy.",
                "properties": {
                  "costReportGroups": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 50,
                      "minLength": 1
                    },
                    "maxItems": 250,
                    "description": "Valid cost-report-group values selectable on lease templates."
                  },
                  "requireCostReportGroup": {
                    "type": "boolean",
                    "description": "Whether a cost report group is required on lease templates."
                  },
                  "lastSavedBy": {
                    "type": "string",
                    "description": "Email of the last administrator to save the section, or a \`system:\` sentinel.",
                    "format": "password"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/ConfigurationResponseMetadata"
                  }
                },
                "required": [
                  "costReportGroups",
                  "requireCostReportGroup"
                ]
              },
              "CreateLeaseTemplateRequestContent": {
                "type": "object",
                "description": "The client-writable members of a lease template, shared by the create and\\nupdate inputs. Both accept the same set — requiredness and constraints are\\nidentical and neither operation is a patch.\\n\\n\`uuid\`, \`createdBy\` and \`blueprintName\` are deliberately absent — they are\\nserver-owned.",
                "properties": {
                  "maxSpend": {
                    "type": "number",
                    "format": "double"
                  },
                  "budgetThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/BudgetThreshold"
                    }
                  },
                  "leaseDurationInHours": {
                    "type": "number",
                    "format": "double"
                  },
                  "durationThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DurationThreshold"
                    }
                  },
                  "costReportGroup": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "requiresApproval": {
                    "type": "boolean"
                  },
                  "visibility": {
                    "$ref": "#/components/schemas/Visibility"
                  },
                  "blueprintId": {
                    "type": "string",
                    "description": "Blueprint to attach. \`blueprintName\` is resolved server-side."
                  },
                  "allowOwnerToShareLease": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "requiresApproval"
                ]
              },
              "CreateLeaseTemplateResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/LeaseTemplate"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "CurrentLease": {
                "type": "object",
                "description": "The lease currently occupying the account, when one does.",
                "properties": {
                  "leaseId": {
                    "type": "string"
                  },
                  "ownerEmail": {
                    "type": "string",
                    "description": "An email address.",
                    "format": "password"
                  }
                },
                "required": [
                  "leaseId",
                  "ownerEmail"
                ]
              },
              "DeleteBlueprintData": {
                "type": "object",
                "description": "The delete success payload: a confirmation message plus the deleted blueprint id.",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Blueprint unregistered successfully"
                  },
                  "blueprintId": {
                    "type": "string",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "A blueprint id — the server-generated UUID. The pattern is the exact RFC layout\\n(versions 1–8, variant 8/9/a/b, plus the nil and max UUIDs), so a hex-shaped but\\nRFC-invalid id is rejected 400 rather than returning 404.",
                    "example": "12345678-90ab-4cde-8f12-34567890abcd"
                  }
                },
                "required": [
                  "blueprintId",
                  "message"
                ]
              },
              "DeleteBlueprintResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/DeleteBlueprintData"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "DeleteLeaseTemplateResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "DeploymentHistory": {
                "type": "object",
                "properties": {
                  "stackSetId": {
                    "type": "string"
                  },
                  "leaseId": {
                    "type": "string"
                  },
                  "accountId": {
                    "type": "string"
                  },
                  "status": {
                    "$ref": "#/components/schemas/DeploymentStatus"
                  },
                  "operationId": {
                    "type": "string"
                  },
                  "deploymentStartedAt": {
                    "type": "string"
                  },
                  "deploymentCompletedAt": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "number",
                    "format": "double"
                  },
                  "errorType": {
                    "type": "string"
                  },
                  "errorMessage": {
                    "type": "string"
                  }
                },
                "required": [
                  "accountId",
                  "deploymentStartedAt",
                  "leaseId",
                  "operationId",
                  "stackSetId",
                  "status"
                ]
              },
              "DeploymentStatus": {
                "type": "string",
                "description": "StackSet-operation deployment status (mirrors the CloudFormation values).",
                "enum": [
                  "RUNNING",
                  "SUCCEEDED",
                  "FAILED",
                  "QUEUED"
                ]
              },
              "DesiredAssignment": {
                "type": "object",
                "description": "A caller-supplied desired assignment: the target principal and its kind. Used by\\n\`RequestLease\` and \`UpdateLeaseAssignments\` request bodies.",
                "properties": {
                  "principalId": {
                    "type": "string",
                    "description": "IDC principal id."
                  },
                  "principalType": {
                    "$ref": "#/components/schemas/PrincipalType"
                  }
                },
                "required": [
                  "principalId",
                  "principalType"
                ]
              },
              "DesiredAssignmentWithDisplay": {
                "type": "object",
                "description": "A desired assignment enriched with display metadata.",
                "properties": {
                  "principalId": {
                    "type": "string"
                  },
                  "principalType": {
                    "$ref": "#/components/schemas/PrincipalType"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "description": "An email address.",
                    "format": "password"
                  }
                },
                "required": [
                  "principalId",
                  "principalType"
                ]
              },
              "DurationThreshold": {
                "type": "object",
                "properties": {
                  "hoursRemaining": {
                    "type": "number",
                    "format": "double",
                    "example": 12
                  },
                  "action": {
                    "$ref": "#/components/schemas/ThresholdAction"
                  }
                },
                "required": [
                  "action",
                  "hoursRemaining"
                ]
              },
              "EjectAccountResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "FieldError": {
