              "ListLeaseTemplatesResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/LeaseTemplatePage"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "ListLeasesResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/ListLeasesResult"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "ListLeasesResult": {
                "type": "object",
                "description": "\`error\` is an optional diagnostic warning string. It is non-contractual, not a\\nfailure.",
                "properties": {
                  "result": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/LeaseWithId"
                    }
                  },
                  "nextPageIdentifier": {
                    "type": "string",
                    "description": "Opaque pagination token.",
                    "format": "password"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "ListSharedLeasesResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/ListSharedLeasesResult"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "ListSharedLeasesResult": {
                "type": "object",
                "properties": {
                  "result": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SharedLease"
                    }
                  },
                  "nextPageIdentifier": {
                    "type": "string",
                    "description": "Opaque pagination token.",
                    "format": "password"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "ListStackSetsResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/ListStackSetsResult"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "ListStackSetsResult": {
                "type": "object",
                "properties": {
                  "result": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/StackSetSummary"
                    }
                  },
                  "nextPageIdentifier": {
                    "type": "string",
                    "description": "Opaque pagination token.",
                    "format": "password"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "ListUnregisteredAccountsResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/ListUnregisteredAccountsResult"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "ListUnregisteredAccountsResult": {
                "type": "object",
                "properties": {
                  "result": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/UnregisteredAccount"
                    }
                  },
                  "nextPageIdentifier": {
                    "type": "string",
                    "description": "Opaque pagination token.",
                    "format": "password"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "LockMeta": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "MaintenanceConfiguration": {
                "type": "object",
                "description": "Maintenance-mode toggle.",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "When true, prevents creation of new leases. Fresh installs default to true."
                  },
                  "lastSavedBy": {
                    "type": "string",
                    "description": "Email of the last administrator to save the section, or a \`system:\` sentinel.",
                    "format": "password"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/ConfigurationResponseMetadata"
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "Metadata": {
                "type": "object",
                "description": "Server-owned record metadata.",
                "properties": {
                  "createdTime": {
                    "type": "string",
                    "description": "Time when the resource was created, as an ISO 8601 string.",
                    "format": "date-time",
                    "example": "2023-05-01T12:00:00Z"
                  },
                  "lastEditTime": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2023-05-01T12:00:00Z"
                  },
                  "schemaVersion": {
                    "type": "number",
                    "description": "This shape is deprecated: Scheduled for removal in a future API version.",
                    "deprecated": true,
                    "example": 1
                  }
                }
              },
              "NotFoundErrorResponseContent": {
                "type": "object",
                "description": "The addressed resource does not exist, or the caller is not entitled to\\nlearn that it exists. A PRIVATE lease template returns this rather than a 403\\nto callers without the Admin or Manager role.",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "message": {
                    "type": "string"
                  },
                  "data": {
                    "$ref": "#/components/schemas/JSendErrorData"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "NotificationConfiguration": {
                "type": "object",
                "description": "Notification sender configuration.",
                "properties": {
                  "emailFrom": {
                    "type": "string",
                    "maxLength": 254,
                    "description": "From address used for notification emails; an empty string disables\\nnotifications.",
                    "format": "password",
                    "example": "isb-noreply@example.com"
                  },
                  "lastSavedBy": {
                    "type": "string",
                    "description": "Email of the last administrator to save the section, or a \`system:\` sentinel.",
                    "format": "password"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/ConfigurationResponseMetadata"
                  }
                },
                "required": [
                  "emailFrom"
                ]
              },
              "Principal": {
                "type": "object",
                "description": "A resolved IDC principal in the search response.",
                "properties": {
                  "principalId": {
                    "type": "string",
                    "description": "IDC identifier for the user or group.",
                    "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                  },
                  "principalType": {
                    "$ref": "#/components/schemas/PrincipalType"
                  },
                  "displayName": {
                    "type": "string",
                    "description": "Human-readable name shown in the assignment UI. Optional: may be absent\\nwhen the principal has no display name.",
                    "example": "Jane Doe"
                  },
                  "email": {
                    "type": "string",
                    "description": "Present for users, absent for groups.",
                    "format": "password",
                    "example": "jane@example.com"
                  }
                },
                "required": [
                  "principalId",
                  "principalType"
                ]
              },
              "PrincipalSearchResult": {
                "type": "object",
                "description": "The \`data\` payload of a principal search: the (capped) matches plus the total\\nthat matched before \`limit\` was applied.",
                "properties": {
                  "principals": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Principal"
                    }
                  },
                  "totalMatches": {
                    "type": "number",
                    "description": "Total matches before the \`limit\` cap (the returned list may be shorter).",
                    "example": 47
                  }
                },
                "required": [
                  "principals",
                  "totalMatches"
                ]
              },
              "PrincipalSearchTypeFilter": {
                "type": "string",
                "description": "The \`type\` query filter: restrict to users, groups, or both. The public wire\\nvalues are lowercase.",
                "enum": [
                  "users",
                  "groups",
                  "all"
                ]
              },
              "PrincipalType": {
                "type": "string",
                "description": "Whether a matched principal is an IDC user or group.",
                "enum": [
                  "USER",
                  "GROUP"
                ]
              },
              "QuarantineAccountResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "RegionConcurrencyType": {
                "type": "string",
                "description": "CloudFormation StackSet region-deployment ordering.",
                "enum": [
                  "SEQUENTIAL",
                  "PARALLEL"
                ]
              },
              "RegisterAccountRequestContent": {
                "type": "object",
                "properties": {
                  "awsAccountId": {
                    "type": "string",
                    "pattern": "^[0-9]{12}$",
                    "description": "A 12-digit AWS account id."
                  }
                },
                "required": [
                  "awsAccountId"
                ]
              },
              "RegisterAccountResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/SandboxAccount"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "RegisterBlueprintRequestContent": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,49}$",
                    "example": "Web-Application-Blueprint"
                  },
                  "stackSetId": {
                    "type": "string",
                    "minLength": 1,
                    "example": "12345678-1234-1234-1234-123456789012"
                  },
                  "regions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "description": "At least one region.",
                    "example": [
                      "us-east-1",
                      "us-west-2"
                    ]
                  },
                  "tags": {
                    "$ref": "#/components/schemas/BlueprintTags"
                  },
                  "deploymentTimeoutMinutes": {
                    "type": "number",
                    "maximum": 480,
                    "minimum": 5,
                    "format": "double",
                    "example": 60
                  },
                  "regionConcurrencyType": {
                    "$ref": "#/components/schemas/RegionConcurrencyType"
                  },
                  "maxConcurrentPercentage": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 1
                  },
                  "failureTolerancePercentage": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0
                  },
                  "concurrencyMode": {
                    "$ref": "#/components/schemas/ConcurrencyMode"
                  }
                },
                "required": [
                  "name",
                  "regions",
                  "stackSetId"
                ]
              },
              "RegisterBlueprintResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/Blueprint"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "RequestLeaseRequestContent": {
                "type": "object",
                "properties": {
                  "leaseTemplateUuid": {
                    "type": "string",
                    "description": "Template to request from. Public request field name (not\\n\`originalLeaseTemplateUuid\`)."
                  },
                  "userEmail": {
                    "type": "string",
                    "description": "On-behalf target user. Omitted for a self-request.",
                    "format": "password"
                  },
                  "comments": {
                    "type": "string"
                  },
                  "assignments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DesiredAssignment"
                    },
                    "maxItems": 19
                  }
                },
                "required": [
                  "leaseTemplateUuid"
                ]
              },
              "RequestLeaseResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/Lease"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "ResourceCount": {
                "type": "object",
                "properties": {
                  "totalCount": {
                    "type": "number",
                    "example": 42
                  },
                  "ignoredCount": {
                    "type": "number",
                    "example": 5
                  },
                  "byType": {
                    "$ref": "#/components/schemas/ResourceCountByType"
                  }
                },
                "required": [
                  "byType",
                  "ignoredCount",
                  "totalCount"
                ]
              },
              "ResourceCountByType": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "description": "Counts of resources found, by phase.",
                "example": {
                  "ec2:instance": 3,
                  "s3:bucket": 2,
                  "logs:log-group": 12
                }
              },
              "ResourceEntry": {
                "type": "object",
                "properties": {
                  "arn": {
                    "type": "string"
                  },
                  "resourceType": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  }
                },
                "required": [
                  "arn",
                  "region",
                  "resourceType"
                ]
              },
              "ResourceLock": {
                "type": "object",
                "description": "Record-level optimistic lock. Timestamps are ISO 8601 strings.",
                "properties": {
                  "ownerId": {
                    "type": "string"
                  },
                  "acquiredAt": {
                    "type": "string"
                  },
                  "expiresAt": {
                    "type": "string"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/LockMeta"
                  }
                },
                "required": [
                  "acquiredAt",
                  "expiresAt",
                  "ownerId"
                ]
              },
              "ResourceSummary": {
                "type": "object",
                "description": "Resource-scan summary written after cleanup validation.",
                "properties": {
                  "validationMode": {
                    "type": "string",
                    "description": "Validation mode in effect: \`Quarantine\` enforces (a failed validation\\nquarantines the account); \`Warn\` surfaces remaining resources without\\nblocking; \`Silent\` records metrics only. Absent if validation did not run.",
                    "example": "Quarantine"
                  },
                  "beforeCleanup": {
                    "$ref": "#/components/schemas/ResourceCount"
                  },
                  "afterCleanup": {
                    "$ref": "#/components/schemas/ResourceCount"
                  },
                  "afterCooldown": {
                    "$ref": "#/components/schemas/ResourceCount"
                  },
                  "remainingTypes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": []
                  },
                  "remainingResources": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ResourceEntry"
                    }
                  },
                  "remainingResourcesTotalCount": {
                    "type": "number"
                  },
                  "ignoredResources": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ResourceEntry"
                    }
                  },
                  "ignoredResourcesTotalCount": {
                    "type": "number"
                  }
                }
              },
              "RetryCleanupResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "ReviewAction": {
                "type": "string",
                "description": "The review decision for a pending lease.",
                "enum": [
                  "Approve",
                  "Deny"
                ]
              },
              "ReviewLeaseRequestContent": {
                "type": "object",
                "properties": {
                  "action": {
                    "$ref": "#/components/schemas/ReviewAction"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "ReviewLeaseResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "SandboxAccount": {
                "type": "object",
                "description": "A registered sandbox account.",
                "properties": {
                  "awsAccountId": {
                    "type": "string",
                    "pattern": "^[0-9]{12}$",
                    "description": "A 12-digit AWS account id.",
                    "example": "123456789012"
                  },
                  "status": {
                    "$ref": "#/components/schemas/SandboxAccountStatus"
                  },
                  "email": {
                    "type": "string",
                    "description": "An email address.",
                    "format": "password"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 50
                  },
                  "driftAtLastScan": {
                    "type": "boolean",
                    "example": false
                  },
                  "activeCleanup": {
                    "$ref": "#/components/schemas/ActiveCleanup"
                  },
                  "lastCleanupCompletedAt": {
                    "type": "string"
                  },
                  "currentLease": {
                    "$ref": "#/components/schemas/CurrentLease"
                  },
                  "cleanupExecutionContext": {
                    "$ref": "#/components/schemas/CleanupExecutionContext"
                  },
                  "resourceLock": {
                    "$ref": "#/components/schemas/ResourceLock"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/AccountMetadata"
                  }
                },
                "required": [
                  "awsAccountId",
                  "status"
                ]
              },
              "SandboxAccountStatus": {
                "type": "string",
                "description": "The account's operational state (the ISB OU it sits in, excluding the\\ntransient Entry/Exit OUs). Registered accounts are always one of these.",
                "enum": [
                  "Available",
                  "Active",
                  "CleanUp",
                  "Quarantine",
                  "Frozen"
                ],
                "example": "Available"
              },
              "SearchPrincipalsResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/PrincipalSearchResult"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "SharedLease": {
                "type": "object",
                "description": "A \`Lease\` reachable through a shared assignment, with the access path and\\n(for group access) the group that granted it. Also carries the \`leaseId\`.",
                "properties": {
                  "userEmail": {
                    "type": "string",
                    "description": "Lease owner / assignee email. Half of the composite key.",
                    "format": "password"
                  },
                  "uuid": {
                    "type": "string",
                    "description": "Server-generated lease UUID. Half of the composite key."
                  },
                  "status": {
                    "$ref": "#/components/schemas/LeaseStatus"
                  },
                  "originalLeaseTemplateUuid": {
                    "type": "string",
                    "description": "UUID of the lease template this lease was requested from."
                  },
                  "originalLeaseTemplateName": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "description": "Name copied from the template at request time."
                  },
                  "comments": {
                    "type": "string",
                    "description": "Free-text requester comments (max 1000 characters)."
                  },
                  "createdBy": {
                    "type": "string",
                    "description": "Set only for a cross-user (on-behalf) request; the elevated caller's email.",
                    "format": "password"
                  },
                  "blueprintId": {
                    "type": "string",
                    "description": "Blueprint copied from the template for deployment. Absent when the template had\\nnone."
                  },
                  "blueprintName": {
                    "type": "string"
                  },
                  "allowOwnerToShareLease": {
                    "type": "boolean"
                  },
                  "desiredAssignments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DesiredAssignmentWithDisplay"
                    },
                    "description": "Declarative desired principal assignments (owner + shared users/groups),\\neach optionally enriched with display metadata for the assignments UI."
                  },
                  "resourceLock": {
                    "$ref": "#/components/schemas/LeaseResourceLock"
                  },
                  "maxSpend": {
                    "type": "number",
                    "format": "double"
                  },
                  "budgetThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/BudgetThreshold"
                    }
                  },
                  "leaseDurationInHours": {
                    "type": "number",
                    "format": "double"
                  },
                  "durationThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DurationThreshold"
                    }
                  },
                  "costReportGroup": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1
                  },
                  "meta": {
                    "$ref": "#/components/schemas/LeaseMetadata"
                  },
                  "awsAccountId": {
                    "type": "string",
                    "pattern": "^[0-9]{12}$",
                    "description": "A 12-digit AWS account id."
                  },
                  "approvedBy": {
                    "type": "string",
                    "description": "Approver email or the literal \`AUTO_APPROVED\`."
                  },
                  "startDate": {
                    "type": "string",
                    "description": "ISO 8601 instant."
                  },
                  "expirationDate": {
                    "type": "string"
                  },
                  "lastCheckedDate": {
                    "type": "string"
                  },
                  "totalCostAccrued": {
                    "type": "number",
                    "format": "double"
                  },
                  "endDate": {
                    "type": "string"
                  },
                  "ttl": {
                    "type": "number",
                    "description": "TTL as a Unix-epoch-seconds timestamp. Present on terminal/denied leases."
                  },
                  "leaseId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "description": "A lease's public identifier: the base64url-encoded \`{userEmail, uuid}\` composite\\nkey (URL-safe alphabet, no padding). Present on read/unfreeze outputs and list\\nitems; absent from the \`Lease\` returned by \`RequestLease\`/\`UpdateLease\`.",
                    "example": "BASE64STRING"
                  },
                  "accessType": {
                    "$ref": "#/components/schemas/SharedLeaseAccessType"
                  },
                  "sourceGroupName": {
                    "type": "string",
                    "description": "The IDC group display name that granted access, present only for\\n\`group\` access."
                  }
                },
                "required": [
                  "accessType",
                  "leaseId",
                  "originalLeaseTemplateName",
                  "originalLeaseTemplateUuid",
                  "status",
                  "userEmail",
                  "uuid"
                ]
              },
              "SharedLeaseAccessType": {
                "type": "string",
                "description": "The access path by which a shared lease reaches a user: a direct principal\\nassignment or membership in an assigned group. Wire values are lowercase.",
                "enum": [
                  "direct",
                  "group"
                ]
              },
              "SkipCooldownData": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ]
              },
              "SkipCooldownResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
                  "data": {
                    "$ref": "#/components/schemas/SkipCooldownData"
                  }
                },
                "required": [
                  "data",
                  "status"
                ]
              },
              "StackSetConfig": {
                "type": "object",
                "description": "A blueprint's StackSet configuration.",
                "properties": {
                  "blueprintId": {
                    "type": "string",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "A blueprint id — the server-generated UUID. The pattern is the exact RFC layout\\n(versions 1–8, variant 8/9/a/b, plus the nil and max UUIDs), so a hex-shaped but\\nRFC-invalid id is rejected 400 rather than returning 404.",
                    "example": "12345678-90ab-4cde-8f12-34567890abcd"
                  },
                  "stackSetId": {
                    "type": "string",
                    "example": "12345678-1234-1234-1234-123456789012"
                  },
                  "administrationRoleArn": {
                    "type": "string",
                    "example": "arn:aws:iam::123456789012:role/StackSetAdministrationRole"
                  },
                  "executionRoleName": {
                    "type": "string",
                    "example": "StackSetExecutionRole"
                  },
                  "regions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "description": "At least one region.",
                    "example": [
                      "us-east-1",
                      "us-west-2"
                    ]
                  },
                  "deploymentOrder": {
                    "type": "number",
                    "format": "double",
