                "",
                [
                  "arn:",
                  {
                    "Ref": "AWS::Partition"
                  },
                  ":ssm:",
                  {
                    "Ref": "AWS::Region"
                  },
                  ":",
                  {
                    "Ref": "IdcAccountId"
                  },
                  ":parameter/InnovationSandbox_",
                  {
                    "Ref": "Namespace"
                  },
                  "_Idc_Configuration"
