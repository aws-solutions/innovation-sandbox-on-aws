              "post": {
                "description": "Skip an account's active cleanup cooldown by resuming the durable execution.\\n409 when there is no active cooldown or callback to resume.",
                "operationId": "SkipCooldown",
                "parameters": [
                  {
                    "name": "awsAccountId",
                    "in": "path",
