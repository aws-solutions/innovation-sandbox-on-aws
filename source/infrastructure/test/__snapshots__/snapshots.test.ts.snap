                        {
                          "DefaultValue": ""
                        }
                      ]
                    },
                    ":latest"
                  ]
                ]
              },
              {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::FindInMap": [
                        "Mapping",
                        "context",
                        "publicEcrRegistry",
                        {
                          "DefaultValue": ""
                        }
                      ]
                    },
                    "/",
                    {
                      "Fn::FindInMap": [
                        "Mapping",
                        "context",
                        "solutionName",
                        {
                          "DefaultValue": ""
                        }
                      ]
                    },
                    "-account-cleaner:",
                    {
                      "Fn::If": [
                        "UseStableTaggingCondition",
                        {
                          "Fn::Join": [
                            ".",
                            [
                              {
                                "Fn::Select": [
                                  0,
                                  {
                                    "Fn::Split": [
                                      ".",
                                      {
                                        "Fn::FindInMap": [
                                          "Mapping",
                                          "context",
                                          "publicEcrTag",
                                          {
                                            "DefaultValue": ""
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "Fn::Select": [
                                  1,
                                  {
                                    "Fn::Split": [
                                      ".",
                                      {
                                        "Fn::FindInMap": [
                                          "Mapping",
                                          "context",
                                          "publicEcrTag",
                                          {
                                            "DefaultValue": ""
                                          }
                                        ]
