                          "value": {
                            "leaseTemplateUuid": "12345678-90ab-4cde-8f12-34567890abcd",
                            "comments": "This is a comment",
                            "assignments": [
                              {
                                "principalId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                                "principalType": "USER"
                              }
                            ]
