                      }
                    ]
                  }
                }
              },
              "put": {
                "description": "Replace a lease's desired principal assignments (declarative). Accepted\\nasynchronously: success is 202 with \`{ desiredCount }\` — the assignment worker\\nreconciles out of band. \`@idempotent\`: PUT sets the desired set, so a retry\\nconverges to the same state. \`assignments\` is capped at 19. Owner callers require\\nlease sharing enabled globally and on the lease (else 403). When group assignment\\nmode is \`NONE\`, existing group-to-lease associations may remain or be removed,\\nbut new associations are rejected. 404 when missing; 409 when the lease is not\\nactive or another operation holds the lock.",
                "operationId": "UpdateLeaseAssignments",
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/UpdateLeaseAssignmentsRequestContent"
