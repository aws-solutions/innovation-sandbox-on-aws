                ]
              },
              "JSendErrorData": {
                "type": "object",
                "description": "Failure payload. Populated for validation failures; absent on errors that\\ncarry only a top-level message.",
                "properties": {
                  "errors": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/FieldError"
                    }
                  }
                }
              },
              "JSendStatus": {
                "type": "string",
                "description": "\`success\` on 2xx, \`fail\` on 4xx, \`error\` on 5xx.",
                "enum": [
                  "success",
                  "fail",
                  "error"
                ]
              },
              "Lease": {
                "type": "object",
                "description": "The public lease projection. Body-returning writes (\`RequestLease\`,\\n\`UpdateLease\`) emit this WITHOUT \`leaseId\`; read paths emit \`LeaseWithId\`.",
                "properties": {
                  "userEmail": {
                    "type": "string",
                    "description": "Lease owner / assignee email. Half of the composite key.",
                    "format": "password",
                    "example": "user@example.com"
                  },
                  "uuid": {
                    "type": "string",
                    "description": "Server-generated lease UUID. Half of the composite key.",
                    "example": "12345678-90ab-4cde-8f12-34567890abcd"
                  },
                  "status": {
                    "$ref": "#/components/schemas/LeaseStatus"
                  },
                  "originalLeaseTemplateUuid": {
                    "type": "string",
                    "description": "UUID of the lease template this lease was requested from.",
                    "example": "12345678-90ab-4cde-8f12-34567890abcd"
                  },
                  "originalLeaseTemplateName": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "description": "Name copied from the template at request time.",
                    "example": "Example Template"
                  },
                  "comments": {
                    "type": "string",
                    "description": "Free-text requester comments (max 1000 characters).",
                    "example": "This is a comment"
                  },
                  "createdBy": {
                    "type": "string",
                    "description": "Set only for a cross-user (on-behalf) request; the elevated caller's email.",
                    "format": "password"
                  },
                  "blueprintId": {
                    "type": "string",
                    "description": "Blueprint copied from the template for deployment. Absent when the template had\\nnone."
                  },
                  "blueprintName": {
                    "type": "string"
                  },
                  "allowOwnerToShareLease": {
                    "type": "boolean",
                    "example": false
                  },
                  "desiredAssignments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DesiredAssignmentWithDisplay"
                    },
                    "description": "Declarative desired principal assignments (owner + shared users/groups),\\neach optionally enriched with display metadata for the assignments UI."
                  },
                  "resourceLock": {
                    "$ref": "#/components/schemas/LeaseResourceLock"
                  },
                  "maxSpend": {
                    "type": "number",
                    "format": "double",
                    "example": 100
                  },
                  "budgetThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/BudgetThreshold"
                    }
                  },
                  "leaseDurationInHours": {
                    "type": "number",
                    "format": "double",
                    "example": 24
                  },
                  "durationThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DurationThreshold"
                    }
                  },
                  "costReportGroup": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "Engineering"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/LeaseMetadata"
                  },
                  "awsAccountId": {
                    "type": "string",
                    "pattern": "^[0-9]{12}$",
                    "description": "A 12-digit AWS account id.",
                    "example": "123456789012"
                  },
                  "approvedBy": {
                    "type": "string",
                    "description": "Approver email or the literal \`AUTO_APPROVED\`.",
                    "example": "admin@example.com"
                  },
                  "startDate": {
                    "type": "string",
                    "description": "ISO 8601 instant.",
                    "example": "2025-01-15T08:30:00Z"
                  },
                  "expirationDate": {
                    "type": "string",
                    "example": "2025-01-22T08:30:00Z"
                  },
                  "lastCheckedDate": {
                    "type": "string"
                  },
                  "totalCostAccrued": {
                    "type": "number",
                    "format": "double",
                    "example": 45.67
                  },
                  "endDate": {
                    "type": "string",
                    "example": "2025-01-22T08:30:00Z"
                  },
                  "ttl": {
                    "type": "number",
                    "description": "TTL as a Unix-epoch-seconds timestamp. Present on terminal/denied leases."
                  }
                },
                "required": [
                  "originalLeaseTemplateName",
                  "originalLeaseTemplateUuid",
                  "status",
                  "userEmail",
                  "uuid"
                ]
              },
              "LeaseAssignmentsView": {
                "type": "object",
                "description": "The assignments view plus the operation currently reconciling it.",
                "properties": {
                  "assignments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/AssignmentView"
                    }
                  },
                  "operationInProgress": {
                    "$ref": "#/components/schemas/LeaseLockIntent"
                  }
                },
                "required": [
                  "assignments"
                ]
              },
              "LeaseLockIntent": {
                "type": "string",
                "description": "Intent recorded on a lease's concurrency lock. Critical intents\\n(\`TERMINATE\`, \`FREEZE\`) can preempt overridable ones (\`UPDATE\`, \`PUBLISH\`,\\n\`UNFREEZE\`).",
                "enum": [
                  "TERMINATE",
                  "FREEZE",
                  "UPDATE",
                  "PUBLISH",
                  "UNFREEZE"
                ]
              },
              "LeaseLockMeta": {
                "type": "object",
                "description": "Lock context for a lease.",
                "properties": {
                  "intent": {
                    "$ref": "#/components/schemas/LeaseLockIntent"
                  }
                },
                "required": [
                  "intent"
                ]
              },
              "LeaseMetadata": {
                "type": "object",
                "description": "Lease record metadata: creation and last-edit timestamps.",
                "properties": {
                  "createdTime": {
                    "type": "string",
                    "example": "2023-05-01T12:00:00Z"
                  },
                  "lastEditTime": {
                    "type": "string",
                    "example": "2023-05-01T12:00:00Z"
                  }
                }
              },
              "LeaseResourceLock": {
                "type": "object",
                "description": "A lease's record-level optimistic lock, held while assignment processing runs.\\nClients read it to gate lease actions; a lock whose \`expiresAt\` has passed is\\ntreated as absent.",
                "properties": {
                  "ownerId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Identifier of the operation holding the lock."
                  },
                  "acquiredAt": {
                    "type": "string",
                    "description": "When the lock was acquired."
                  },
                  "expiresAt": {
                    "type": "string",
                    "description": "When the lock expires; past this point the lock is treated as absent."
                  },
                  "meta": {
                    "$ref": "#/components/schemas/LeaseLockMeta"
                  }
                },
                "required": [
                  "acquiredAt",
                  "expiresAt",
                  "ownerId"
                ]
              },
              "LeaseStatus": {
                "type": "string",
                "description": "Every lease lifecycle status.",
                "enum": [
                  "PendingApproval",
                  "ApprovalDenied",
                  "Active",
                  "Frozen",
                  "Provisioning",
                  "Expired",
                  "BudgetExceeded",
                  "ManuallyTerminated",
                  "UserTerminated",
                  "AccountQuarantined",
                  "Ejected",
                  "ProvisioningFailed"
                ],
                "example": "Active"
              },
              "LeaseTemplate": {
                "type": "object",
                "description": "Budget and duration settings shared by the template and its create input.\\nThe hour and dollar fields accept fractional values, so a 1.5-hour template\\nis valid; each must be greater than zero.",
                "properties": {
                  "maxSpend": {
                    "type": "number",
                    "format": "double",
                    "example": 100
                  },
                  "budgetThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/BudgetThreshold"
                    }
                  },
                  "leaseDurationInHours": {
                    "type": "number",
                    "format": "double",
                    "example": 24
                  },
                  "durationThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DurationThreshold"
                    }
                  },
                  "costReportGroup": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "Engineering"
                  },
                  "uuid": {
                    "type": "string",
                    "description": "Unique identifier for the lease template.",
                    "example": "12345678-90ab-4cde-8f12-34567890abcd"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "Example Template"
                  },
                  "description": {
                    "type": "string",
                    "example": "Example Template Description"
                  },
                  "requiresApproval": {
                    "type": "boolean",
                    "example": true
                  },
                  "createdBy": {
                    "type": "string",
                    "description": "Owner email.",
                    "format": "password",
                    "example": "user@example.com"
                  },
                  "visibility": {
                    "$ref": "#/components/schemas/Visibility"
                  },
                  "blueprintId": {
                    "type": "string",
                    "example": "12345678-90ab-4cde-8f12-34567890abcd"
                  },
                  "blueprintName": {
                    "type": "string",
                    "description": "Resolved from the blueprint store; not client-provided."
                  },
                  "allowOwnerToShareLease": {
                    "type": "boolean",
                    "example": false
                  },
                  "meta": {
                    "$ref": "#/components/schemas/Metadata"
                  }
                },
                "required": [
                  "allowOwnerToShareLease",
                  "createdBy",
                  "name",
                  "requiresApproval",
                  "uuid",
                  "visibility"
                ]
              },
              "LeaseTemplatePage": {
                "type": "object",
                "description": "Paginated payload. \`nextPageIdentifier\` is null on the final page.",
                "properties": {
                  "result": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/LeaseTemplate"
                    }
                  },
                  "nextPageIdentifier": {
                    "type": "string",
                    "description": "Opaque continuation token.",
                    "format": "password"
                  }
                },
                "required": [
                  "result"
                ]
              },
              "LeaseWithId": {
                "type": "object",
                "description": "A \`Lease\` that carries the \`leaseId\` (base64url composite key). Returned by\\n\`GetLease\` and \`UnfreezeLease\` and as the \`ListLeases\` result items.",
                "properties": {
                  "userEmail": {
                    "type": "string",
                    "description": "Lease owner / assignee email. Half of the composite key.",
                    "format": "password"
                  },
                  "uuid": {
                    "type": "string",
                    "description": "Server-generated lease UUID. Half of the composite key."
                  },
                  "status": {
                    "$ref": "#/components/schemas/LeaseStatus"
                  },
                  "originalLeaseTemplateUuid": {
                    "type": "string",
                    "description": "UUID of the lease template this lease was requested from."
                  },
                  "originalLeaseTemplateName": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "description": "Name copied from the template at request time."
                  },
                  "comments": {
                    "type": "string",
                    "description": "Free-text requester comments (max 1000 characters)."
                  },
                  "createdBy": {
                    "type": "string",
                    "description": "Set only for a cross-user (on-behalf) request; the elevated caller's email.",
                    "format": "password"
                  },
                  "blueprintId": {
                    "type": "string",
                    "description": "Blueprint copied from the template for deployment. Absent when the template had\\nnone."
                  },
                  "blueprintName": {
                    "type": "string"
                  },
                  "allowOwnerToShareLease": {
                    "type": "boolean"
                  },
                  "desiredAssignments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DesiredAssignmentWithDisplay"
                    },
                    "description": "Declarative desired principal assignments (owner + shared users/groups),\\neach optionally enriched with display metadata for the assignments UI."
                  },
                  "resourceLock": {
                    "$ref": "#/components/schemas/LeaseResourceLock"
                  },
                  "maxSpend": {
                    "type": "number",
                    "format": "double"
                  },
                  "budgetThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/BudgetThreshold"
                    }
                  },
                  "leaseDurationInHours": {
                    "type": "number",
                    "format": "double"
                  },
                  "durationThresholds": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DurationThreshold"
                    }
                  },
                  "costReportGroup": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1
                  },
                  "meta": {
                    "$ref": "#/components/schemas/LeaseMetadata"
                  },
                  "awsAccountId": {
                    "type": "string",
                    "pattern": "^[0-9]{12}$",
                    "description": "A 12-digit AWS account id."
                  },
                  "approvedBy": {
                    "type": "string",
                    "description": "Approver email or the literal \`AUTO_APPROVED\`."
                  },
                  "startDate": {
                    "type": "string",
                    "description": "ISO 8601 instant."
                  },
                  "expirationDate": {
                    "type": "string"
                  },
                  "lastCheckedDate": {
                    "type": "string"
                  },
                  "totalCostAccrued": {
                    "type": "number",
                    "format": "double"
                  },
                  "endDate": {
                    "type": "string"
                  },
                  "ttl": {
                    "type": "number",
                    "description": "TTL as a Unix-epoch-seconds timestamp. Present on terminal/denied leases."
                  },
                  "leaseId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "description": "A lease's public identifier: the base64url-encoded \`{userEmail, uuid}\` composite\\nkey (URL-safe alphabet, no padding). Present on read/unfreeze outputs and list\\nitems; absent from the \`Lease\` returned by \`RequestLease\`/\`UpdateLease\`.",
                    "example": "BASE64STRING"
                  }
                },
                "required": [
                  "leaseId",
                  "originalLeaseTemplateName",
                  "originalLeaseTemplateUuid",
                  "status",
                  "userEmail",
                  "uuid"
                ]
              },
              "LeasesConfiguration": {
                "type": "object",
                "description": "Lease request/budget/duration policy.",
                "properties": {
                  "requireMaxBudget": {
                    "type": "boolean"
                  },
                  "maxBudget": {
                    "type": "number",
                    "maximum": 1000000000,
                    "minimum": 0
                  },
                  "requireMaxDuration": {
                    "type": "boolean"
                  },
                  "maxDurationHours": {
                    "type": "number",
                    "maximum": 87600,
                    "minimum": 0
                  },
                  "maxLeasesPerUser": {
                    "type": "number",
                    "minimum": 1
                  },
                  "ttl": {
                    "type": "number",
                    "minimum": 1,
                    "description": "Number of days the solution stores expired lease records before purging\\nthem."
                  },
                  "allowUserLeaseTermination": {
                    "type": "boolean",
                    "description": "Whether users can self-terminate their own active leases."
                  },
                  "leaseRequestWindowHours": {
                    "type": "number",
                    "minimum": 1,
                    "description": "Rolling window duration (hours) for rate-limiting lease requests."
                  },
                  "maxLeaseRequestsPerWindow": {
                    "type": "number",
                    "minimum": 1,
                    "description": "Maximum number of leases a user can request within the rolling window."
                  },
                  "leaseSharingEnabled": {
                    "type": "boolean",
                    "description": "Whether the multi-user lease-sharing feature is globally enabled."
                  },
                  "enablePrincipalSearch": {
                    "type": "boolean",
                    "description": "Whether the \`GET /principals/search\` typeahead API is available."
                  },
                  "groupAssignmentMode": {
                    "$ref": "#/components/schemas/GroupAssignmentMode"
                  },
                  "lastSavedBy": {
                    "type": "string",
                    "description": "Email of the last administrator to save the section, or a \`system:\` sentinel.",
                    "format": "password"
                  },
                  "meta": {
                    "$ref": "#/components/schemas/ConfigurationResponseMetadata"
                  }
                },
                "required": [
                  "allowUserLeaseTermination",
                  "enablePrincipalSearch",
                  "groupAssignmentMode",
                  "leaseRequestWindowHours",
                  "leaseSharingEnabled",
                  "maxBudget",
                  "maxDurationHours",
                  "maxLeaseRequestsPerWindow",
                  "maxLeasesPerUser",
                  "requireMaxBudget",
                  "requireMaxDuration",
                  "ttl"
                ]
              },
              "ListAccountsResponseContent": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/JSendStatus"
                  },
