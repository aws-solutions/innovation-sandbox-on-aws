                "operationId": "UpdateLeasesConfiguration",
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/UpdateLeasesConfigurationRequestContent"
                      },
                      "examples": {
                        "UpdateLeasesConfiguration_example1": {
                          "summary": "Save the leases configuration",
                          "description": "",
                          "value": {
                            "requireMaxBudget": true,
                            "maxBudget": 100,
                            "requireMaxDuration": true,
                            "maxDurationHours": 168,
                            "maxLeasesPerUser": 3,
                            "ttl": 30,
                            "allowUserLeaseTermination": true,
                            "leaseRequestWindowHours": 168,
                            "maxLeaseRequestsPerWindow": 10,
                            "leaseSharingEnabled": false,
                            "enablePrincipalSearch": true,
                            "groupAssignmentMode": "NONE",
                            "meta": {
                              "lastEditTime": "2026-04-04T12:30:00.000Z"
                            }
                          }
                        },
                        "UpdateLeasesConfiguration_example2": {
                          "summary": "Concurrent-edit conflict",
                          "description": "",
                          "value": {
                            "requireMaxBudget": true,
                            "maxBudget": 100,
                            "requireMaxDuration": true,
                            "maxDurationHours": 168,
                            "maxLeasesPerUser": 3,
                            "ttl": 30,
                            "allowUserLeaseTermination": true,
                            "leaseRequestWindowHours": 168,
                            "maxLeaseRequestsPerWindow": 10,
                            "leaseSharingEnabled": false,
                            "enablePrincipalSearch": true,
                            "groupAssignmentMode": "ALL",
                            "meta": {
                              "lastEditTime": "2026-04-04T12:30:00.000Z"
                            }
                          }
                        }
