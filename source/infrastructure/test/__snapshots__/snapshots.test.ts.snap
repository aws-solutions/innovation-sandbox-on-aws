            "IDC_ACCOUNT_ID": {
              "Ref": "IdcAccountId"
            },
            "ORG_MGT_ACCOUNT_ID": {
              "Ref": "OrgMgtAccountId"
            },
            "HUB_ACCOUNT_ID": {
              "Ref": "AWS::AccountId"
            }
          }
        },
        "FunctionName": {
          "Fn::Join": [
            "",
            [
              "ISB-CostReportingLambda-",
              {
                "Ref": "Namespace"
              }
            ]
          ]
        },
        "Handler": "index.handler",
        "Layers": [
