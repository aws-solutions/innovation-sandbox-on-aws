"{
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterLabels": {
        "Namespace": {
          "default": "Namespace"
        },
        "ClientName": {
          "default": "Client Name"
        },
        "Role": {
          "default": "ISB Role"
        },
        "TrustedPrincipal": {
          "default": "Trusted Principal"
        },
        "MaxSessionDuration": {
          "default": "Max Session Duration (seconds)"
        }
      },
      "ParameterGroups": [
        {
          "Label": {
            "default": "M2M Client Configuration"
          },
          "Parameters": [
            "Namespace",
            "ClientName",
            "Role",
            "TrustedPrincipal",
            "MaxSessionDuration"
          ]
        }
      ]
    }
  },
  "Parameters": {
    "Namespace": {
      "Type": "String",
      "Default": "myisb",
      "AllowedPattern": "^[0-9a-zA-Z]{3,8}$",
      "Description": "The namespace for this deployment of Innovation Sandbox (must be the same for all member stacks). Alphanumeric characters of length between 3 and 8"
    },
    "ClientName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$",
      "ConstraintDescription": "Client name must be 3-32 chars, lowercase alphanumeric and hyphens, no leading/trailing hyphen (e.g., 'deploy-pipeline', 'qa-bot').",
      "Description": "Short identifier for this M2M client (e.g. 'deploy-pipeline'). Becomes part of the IAM role name and CloudTrail audit. 3-32 chars, lowercase alphanumeric and hyphens, no leading/trailing hyphen."
    },
    "Role": {
      "Type": "String",
      "AllowedValues": [
        "Admin",
        "Manager",
        "User"
      ],
      "Description": "The ISB role this M2M client gets. Admin > Manager > User in the role hierarchy."
    },
    "TrustedPrincipal": {
      "Type": "String",
      "AllowedPattern": "^(arn:aws:iam::[0-9]{12}:(role|user)/.+|[0-9]{12})$",
      "ConstraintDescription": "TrustedPrincipal must be either an IAM ARN (arn:aws:iam::<accountId>:role/<name> or arn:aws:iam::<accountId>:user/<name>) or a 12-digit AWS account ID.",
      "Description": "An IAM ARN (arn:aws:iam::<accountId>:role/<name> or :user/<name>) to pin to a specific principal, OR a 12-digit account ID to trust any principal in that account that has sts:AssumeRole permission. Both forms also require the per-stack ExternalId."
    },
    "MaxSessionDuration": {
      "Type": "Number",
      "Default": "3600",
      "Description": "Maximum STS session duration for AssumeRole calls against this role, in seconds. Default 3600 (1 hour). Up to 43200 (12 hours) for long-running jobs.",
      "MaxValue": 43200,
      "MinValue": 3600
    },
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
    }
  },
  "Conditions": {
    "TrustedPrincipalIsArn": {
      "Fn::Equals": [
        {
          "Fn::Select": [
            0,
            {
              "Fn::Split": [
                ":",
                {
                  "Ref": "TrustedPrincipal"
                }
              ]
            }
          ]
        },
        "arn"
      ]
    }
  },
  "Mappings": {
    "RoleLowercaseMapping": {
      "Admin": {
        "lowercased": "admin"
      },
      "Manager": {
        "lowercased": "manager"
      },
      "User": {
        "lowercased": "user"
      }
    }
  },
  "Resources": {
    "M2mClientRole4F4E6ECC": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Fn::Select": [
                      2,
                      {
                        "Fn::Split": [
                          "/",
                          {
                            "Ref": "AWS::StackId"
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::If": [
                    "TrustedPrincipalIsArn",
                    {
                      "Ref": "TrustedPrincipal"
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition"
                          },
                          ":iam::",
                          {
                            "Ref": "TrustedPrincipal"
                          },
                          ":root"
                        ]
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": {
          "Fn::Join": [
            "",
            [
              "ISB M2M client role for ",
              {
                "Ref": "ClientName"
              }
            ]
          ]
        },
        "MaxSessionDuration": {
          "Ref": "MaxSessionDuration"
        },
        "Path": {
          "Fn::Join": [
            "",
            [
              "/isb-m2m/",
              {
                "Ref": "Namespace"
              },
              "/"
            ]
          ]
        },
        "RoleName": {
          "Fn::Join": [
            "",
            [
              {
                "Ref": "Namespace"
              },
              "-isb-m2m-",
              {
                "Fn::FindInMap": [
                  "RoleLowercaseMapping",
                  {
                    "Ref": "Role"
                  },
                  "lowercased"
                ]
              },
              "-",
              {
                "Ref": "ClientName"
              }
            ]
          ]
        },
        "Tags": [
          {
            "Key": "aws-solutions:isb-id",
            "Value": {
              "Fn::Join": [
                "",
                [
                  {
                    "Ref": "Namespace"
                  },
                  "_isb"
                ]
              ]
            }
          },
          {
            "Key": "aws-solutions:isb-stack-name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "aws-solutions:isb-stack-type",
            "Value": "M2mClient"
          }
        ]
      },
      "Metadata": {
        "guard": {
          "SuppressedRules": [
            "CFN_NO_EXPLICIT_RESOURCE_NAMES"
          ]
        }
      }
    },
    "M2mClientRoleDefaultPolicy1E2BF7FC": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "execute-api:Invoke",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition"
                    },
                    ":execute-api:",
                    {
                      "Ref": "AWS::Region"
                    },
                    ":",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    ":",
                    {
                      "Fn::Sub": "{{resolve:ssm:/InnovationSandbox_\${Namespace}_Compute_RestApiId}}"
                    },
                    "/*"
                  ]
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "M2mClientRoleDefaultPolicy1E2BF7FC",
        "Roles": [
          {
            "Ref": "M2mClientRole4F4E6ECC"
          }
        ]
      }
    }
  },
  "Outputs": {
    "M2MRoleArn": {
      "Description": "ARN of the M2M IAM role for this client.",
      "Value": {
        "Fn::GetAtt": [
          "M2mClientRole4F4E6ECC",
          "Arn"
        ]
      }
    },
    "M2MExternalId": {
      "Description": "ExternalId for AssumeRole calls against this client's role. Required by the trust policy condition.",
      "Value": {
        "Fn::Select": [
          2,
          {
            "Fn::Split": [
              "/",
              {
                "Ref": "AWS::StackId"
              }
            ]
          }
        ]
      }
    },
    "ApiGatewayArn": {
      "Description": "API Gateway ARN this client role is scoped to. Constructed from the REST API ID parameter.",
      "Value": {
        "Fn::Join": [
          "",
          [
            "arn:",
            {
              "Ref": "AWS::Partition"
            },
            ":execute-api:",
            {
              "Ref": "AWS::Region"
            },
            ":",
            {
              "Ref": "AWS::AccountId"
            },
            ":",
            {
              "Fn::Sub": "{{resolve:ssm:/InnovationSandbox_\${Namespace}_Compute_RestApiId}}"
            },
            "/*"
          ]
        ]
      }
    },
    "ApiGatewayUrl": {
      "Description": "Base URL for invoking the API. Append the API path (e.g. /leases) to make a request.",
      "Value": {
        "Fn::Join": [
          "",
          [
            "https://",
            {
              "Fn::Sub": "{{resolve:ssm:/InnovationSandbox_\${Namespace}_Compute_RestApiId}}"
            },
            ".execute-api.",
            {
              "Ref": "AWS::Region"
            },
            ".",
            {
              "Ref": "AWS::URLSuffix"
            },
            "/prod"
          ]
        ]
      }
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}"
`;

